generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ProductType {
  READY_MADE
  CUSTOM_TAILORED
}

enum ShippingStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  ORANGE_MONEY
  BANK_CARD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TailoringStatus {
  NOT_REQUIRED
  AWAITING_MEASUREMENTS
  UNDER_REVIEW
  APPROVED
  IN_PRODUCTION
  COMPLETED
  REJECTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVED
  RELEASED
  ADJUSTMENT
  RETURNED
}

enum ProductionStatus {
  NOT_STARTED
  MEASUREMENTS_PENDING
  MEASUREMENTS_REVIEW
  DESIGN_APPROVAL
  CUTTING
  SEWING
  FITTING
  QUALITY_CHECK
  COMPLETED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String?
  passwordHash  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  addresses Address[]

  appointments Appointment[]
  measurementProfiles MeasurementProfile[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  image       String?
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  type ProductType @default(READY_MADE)
  variants ProductVariant[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  totalAmount Decimal  @db.Decimal(12, 2)
  status      OrderStatus   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  shippingAddressId String?
  shippingAddress Address? @relation(fields: [shippingAddressId], references: [id])

  shipment Shipment?
  payments Payment[]

  
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?

}


model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String

  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)

  selectedSize  String?
  selectedColor String?

  tailoringStatus TailoringStatus @default(NOT_REQUIRED)
  tailoringNotes  String?
  agreedPrice     Decimal?        @db.Decimal(12, 2)

  measurementProfileId String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  referencePhotos OrderItemPhoto[]
  stockMovements StockMovement[]

  measurementProfile MeasurementProfile? @relation(fields: [measurementProfileId], references: [id])

  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  productionStatus ProductionStatus @default (NOT_STARTED)
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  appointmentDate DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model MeasurementProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Measurements")
  unit      String   @default("CM")

  fullHeight Decimal? @db.Decimal(6, 2)
  neck       Decimal? @db.Decimal(6, 2)
  shoulders  Decimal? @db.Decimal(6, 2)
  chest      Decimal? @db.Decimal(6, 2)
  bust       Decimal? @db.Decimal(6, 2)
  waist      Decimal? @db.Decimal(6, 2)
  hips       Decimal? @db.Decimal(6, 2)
  sleeve     Decimal? @db.Decimal(6, 2)
  inseam     Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id])
  photos MeasurementPhoto[]
  orderItems OrderItem[]
}

model MeasurementPhoto {
  id          String   @id @default(cuid())
  profileId   String
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  profile MeasurementProfile @relation(fields: [profileId], references: [id])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String
  color     String?
  stock     Int     @default(0)
  reservedStock Int @default(0)
  sku       String? @unique

  product Product @relation(fields: [productId], references: [id])
  orderItems OrderItem[]
  movements StockMovement[]

  @@unique([productId, size, color])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  country     String
  region      String
  city        String
  street      String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String         @unique
  trackingNumber  String?        @unique
  carrier         String?
  shippingCost    Decimal        @db.Decimal(12, 2)
  status          ShippingStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("XAF")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)


  provider          String?
  providerReference String?       @unique
  transactionId     String?       @unique
  failureReason     String?

  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]

  order Order @relation(fields: [orderId], references: [id])

  verifiedAt DateTime?
  verificationReference String?
}

model OrderItemPhoto {
  id          String   @id @default(cuid())
  orderItemId String
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())
  orderItemId String?

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  variant ProductVariant @relation(fields: [variantId], references: [id])

  idempotencyKey String? @unique
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  amount            Decimal      @db.Decimal(12, 2)
  reason            String?
  status            RefundStatus @default(PENDING)
  providerReference String?      @unique
  idempotencyKey    String?      @unique
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}